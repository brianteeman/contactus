# Apache 2.4 front-end. PHP runs as FastCGI in the separate php-fpm container;
# Apache proxies *.php requests to it over fcgi://php:9000.
#
# AllowOverride All matters: the component ships .htaccess files denying direct
# web access to its own folders. Without AllowOverride they would be silently
# inert.
#
# Apache only. ContactUs has no server-specific behaviour that would make a second
# (NginX) front-end worth the extra wall-clock: its only web-server-level controls
# are the deny-all .htaccess files (with web.config twins), which are defence in
# depth behind the _JEXEC guard in every PHP file, not the component's access
# control.

ARG APACHE_VERSION=2.4
FROM httpd:${APACHE_VERSION}

RUN sed -i \
        -e 's|^#\(LoadModule proxy_module .*\)|\1|' \
        -e 's|^#\(LoadModule proxy_fcgi_module .*\)|\1|' \
        -e 's|^#\(LoadModule rewrite_module .*\)|\1|' \
        -e 's|^#\(LoadModule deflate_module .*\)|\1|' \
        -e 's|^#\(LoadModule expires_module .*\)|\1|' \
        -e 's|^#\(LoadModule headers_module .*\)|\1|' \
        /usr/local/apache2/conf/httpd.conf \
 && echo 'IncludeOptional conf/extra/e2e-vhost.conf' >> /usr/local/apache2/conf/httpd.conf

COPY config/e2e-vhost.conf /usr/local/apache2/conf/extra/e2e-vhost.conf
